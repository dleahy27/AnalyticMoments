Cell[BoxData[{
 RowBox[{
  RowBox[{"outputFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"resultsDir", ",", "\"\<IntensitiesAnalytic.tex\>\""}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"content", "=", 
   RowBox[{
   "StringJoin", 
    "[", "\"\<% Auto-generated H^{\\\\alpha}(L,M)\\n \\\\begin{align*} \
\\n\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"al", "=", "0"}], ",", 
    RowBox[{"al", "<=", "8"}], ",", 
    RowBox[{"al", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rhs", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"Li", "=", "0"}], ",", 
       RowBox[{"Li", "<=", "Lmax"}], ",", 
       RowBox[{"Li", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"M", "=", "0"}], ",", 
         RowBox[{"M", "<=", "Li"}], ",", 
         RowBox[{"M", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Test", " ", "to", " ", "prove", " ", "CG", " ", "are", " ", 
            "going", " ", "to", " ", "0", " ", "when", " ", "M"}], "!=", 
           RowBox[{"0", " ", 
            RowBox[{"i", ".", "e", ".", " ", "only"}], " ", "theta", " ", 
            "dependence"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Print", "[", 
           RowBox[{
           "Li", ",", " ", "\"\< \>\"", ",", " ", "M", ",", " ", "\"\< \>\"", 
            ",", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Quiet", "@", 
                RowBox[{"ClebschGordan", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"l2", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Li", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"l1", ",", "0"}], "}"}]}], "]"}]}], 
               RowBox[{"Quiet", "@", 
                RowBox[{"ClebschGordan", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"l2", ",", "m2"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Li", ",", "M"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"l1", ",", "m2"}], "}"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"l1", ",", "0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"l2", ",", "0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"m1", ",", 
                RowBox[{"-", "l1"}], ",", "l1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"m2", ",", 
                RowBox[{"-", "l2"}], ",", "l2"}], "}"}]}], "]"}]}], "]"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rhs", " ", "+=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "Li"}], " ", "+", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"4", "Pi"}], ")"}]}], ")"}], " ", 
            RowBox[{"H", "[", 
             RowBox[{"al", ",", "Li", ",", "M"}], "]"}], "*", 
            RowBox[{"Refine", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"WignerD", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Li", ",", "0", ",", 
                   RowBox[{"-", "M"}]}], "}"}], ",", "\[Theta]", ",", 
                 "\[Phi]"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Element", "[", 
                 RowBox[{"\[Theta]", ",", "Reals"}], "]"}], ",", " ", 
                RowBox[{"Element", "[", 
                 RowBox[{"\[Phi]", ",", "Reals"}], "]"}]}], "}"}]}], 
             "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"al", "!=", "0"}], ",", 
       RowBox[{"rhs", "=", 
        RowBox[{"-", "rhs"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"content", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"content", ",", "\"\<  I^{\>\"", ",", 
        RowBox[{"ToString", "@", 
         RowBox[{"TeXForm", "[", "al", "]"}]}], ",", "\"\<} &= \>\"", " ", ",", 
        RowBox[{"ToString", "@", 
         RowBox[{"TeXForm", "[", 
          RowBox[{"1", "/", 
           RowBox[{"Denominator", "@", 
            RowBox[{"FullSimplify", "[", "rhs", "]"}]}]}], "]"}]}], 
        ",", "\"\<\\\\left[\>\"", ",", " ", 
        RowBox[{"ToString", "@", 
         RowBox[{"TeXForm", "@", 
          RowBox[{"Numerator", "@", 
           RowBox[{"Simplify", "[", "rhs", "]"}]}]}]}], 
        ",", "\"\<\\\\right] \\\\\\\\ \\n\>\""}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"content", "=", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"content", ",", "\"\<\\\\end{align*}\\n\>\""}], "]"}]}], ";"}], "\n", 
